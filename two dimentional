public class Demo {

    public static void main(String[] args) {
        int[][] number = {
            {10, 20, 30},
            {40, 50, 60},
            {70, 80, 90}
        };

        for (int i = 0; i < number.length; i++) {
            for (int j = 0; j < number[i].length; j++) {
                System.out.print(number[i][j] + " ");
            }
            System.out.println();
        }
    }
}
